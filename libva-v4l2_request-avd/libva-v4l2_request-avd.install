post_install() {
  cat <<'MSG'
==> The VA-API driver is also available as asahi_drv_video.so, which lets
    libva discover it automatically on the Asahi DRM render node.

    If automatic discovery does not work, select it explicitly:

        LIBVA_DRIVER_NAME=v4l2_request \
          vainfo --display drm --device /dev/dri/renderD128

==> mpv:     LIBVA_DRIVER_NAME=v4l2_request mpv --hwdec=vaapi video.mp4
==> Firefox: additionally needs MOZ_DISABLE_RDD_SANDBOX=1 because its RDD
             sandbox blocks the /dev/video* and /dev/media* access required by
             this driver. Disabling that sandbox reduces media-process safety.
MSG
}

post_upgrade() {
  post_install
}
