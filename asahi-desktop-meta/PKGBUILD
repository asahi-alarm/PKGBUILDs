pkgname=asahi-desktop-meta
pkgver=4
pkgrel=9
pkgdesc='Asahi Linux desktop support meta package'
url='https://www.asahilinux.org'
arch=('any')
license=('MIT')
install=asahi-desktop-meta.install

package() {
  depends=(
    alsa-tools
    alsa-utils
    asahi-audio
    bankstown
    bluez-tools
    bluez-utils
    drm-info
    glmark2
    mesa
    mesa-demos
    mesa-utils
    # our old mesa package bundled these; ALARM splits them into their own
    # packages, so they have to be pulled in explicitly or users lose the asahi
    # vulkan driver, venus (muvm/steam), lavapipe and rusticl on upgrade
    opencl-mesa
    pacman-contrib
    pavucontrol
    pipewire
    pipewire-alsa
    pipewire-audio
    pipewire-pulse
    speakersafetyd
    startup-disk
    virglrenderer
    vulkan-asahi
    vulkan-swrast
    vulkan-tools
    vulkan-virtio
    widevine
    wireplumber
    xkeyboard-config)
}

