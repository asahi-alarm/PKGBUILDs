_name=asahi-alarm-installer
pkgname=asahi-fwextract
pkgver=0.9.2
pkgrel=1
pkgdesc='Asahi Linux firmware extractor'
arch=('any')
url='http://asahilinux.org'
license=('MIT')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/asahi-alarm/${_name}/archive/refs/tags/v${pkgver}.tar.gz")
install=asahi-fwextract.install
sha256sums=('2d4f049d618aa7592db0f6b0bfca1f4485bb2244c74c4d5038681b4b36e305e4')
b2sums=('cb1ebd6e602c3267c0464d4f2dbba446ffa2f25ba27b93685dc3ddf26576f6fbc275996bc81c9c72583ad760f82b4c366cb7ee4f8696bd746b30c4591dcbd3f0')
depends=(python "asahi-scripts>=20230606-1" lzfse)
makedepends=(python-build python-installer python-wheel python-setuptools)

build() {
    cd "$_name-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$_name-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
}
