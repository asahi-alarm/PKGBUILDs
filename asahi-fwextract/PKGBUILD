_name=asahi-alarm-installer
pkgname=asahi-fwextract
pkgver=0.8.4
pkgrel=1
pkgdesc='Asahi Linux firmware extractor'
arch=('any')
url='http://asahilinux.org'
license=('MIT')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/asahi-alarm/${_name}/archive/refs/tags/v${pkgver}.tar.gz")
install=asahi-fwextract.install
sha256sums=('186f4f7065445ed1ce8064b6977f93d994ff531a022f987a2a745d0f6661adc4')
b2sums=('7eeabec6727dd34003f577d6513de0ed2244d863e8106809399fb50e523397aed50a766671bb399927cb31c9cb158f08a5d73d3cace0c891c3b035b857571f0d')
depends=(python "asahi-scripts>=20230606-1" lzfse)
makedepends=(python-build python-installer python-wheel python-setuptools)

build() {
    cd "$_name-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$_name-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
}
